# vault.yml.template
# Copy to inventory/group_vars/all/vault.yml, fill in real values, encrypt with:
#   ansible-vault encrypt inventory/group_vars/all/vault.yml --ask-vault-pass
#
# Every secret in the infrastructure is documented here.
# If a new secret is added, add it here first.
#
# Consolidated 2026-08-04: daftpunk + greenday killed.
# Removed: daftpunk/greenday WG keys, Grafana creds, AI agent SSH key,
# Matrix bot passwords, Matrix PG/registration secrets.

# ── WireGuard private keys (per host) ──────────────────────
# Generate with: wg genkey | tee /tmp/<host>.key | wg pubkey > /tmp/<host>.pub
wg_private_keys:
  rammstein: "PRIVATE_KEY_HERE"
  sophon: "PRIVATE_KEY_HERE"
  yoga: "PRIVATE_KEY_HERE"

# ── WireGuard public keys (per host) ───────────────────────
# Derived from private keys: wg pubkey < /tmp/<host>.key
wg_public_keys:
  rammstein: "PUBLIC_KEY_HERE"
  sophon: "PUBLIC_KEY_HERE"
  yoga: "PUBLIC_KEY_HERE"

# ── Git bare repo SSH authorized keys ──────────────────────
# Public SSH keys for clients that can push/pull to git@rammstein / git@sophon
# Generate on each client: ssh-keygen -t ed25519 -f ~/.ssh/git_key
git_authorized_keys:
  - "ssh-ed25519 AAAA... nacho@yoga"
  - "ssh-ed25519 AAAA... nacho@sophon"

# ── pass GPG key IDs (per host) ─────────────────────────────
# Generate on each client: gpg --full-generate-key (RSA 4096, no expiry)
# Then: gpg --list-secret-keys --keyid-format long
# Each host has its own GPG key for pass encryption.
pass_gpg_id:
  yoga: "GPG_KEY_ID_HERE"
  sophon: "GPG_KEY_ID_HERE"

# ── Restic backup password ─────────────────────────────────
# Used to encrypt all restic repositories (local + remote).
# Choose a strong passphrase. Store in pass after setup.
# Also store on paper in secure physical location (DRP).
restic_password: "CHANGE_ME"

# ── Frigate RTSP camera credentials ────────────────────────
# Shared across all cameras (user/password in RTSP URLs)
frigate_camera_rtsp_user: "CAMERA_USER_HERE"
frigate_camera_rtsp_password: "CAMERA_PASSWORD_HERE"

# ── i.ar agent Telegram notifications ──────────────────────
# Bot token from @BotFather, chat ID from @userinfobot
iar_telegram_bot_token: "BOT_TOKEN_HERE"
iar_telegram_chat_id: "CHAT_ID_HERE"