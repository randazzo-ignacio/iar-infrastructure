[Unit]
Description=Zulip chat server (podman compose)
After=network-online.target podman.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ zulip_compose_dir }}
Environment=COMPOSE_PROJECT_NAME=zulip
Environment=DOCKER_HOST=unix:///run/podman/podman.sock
ExecStart=/usr/bin/podman compose -f compose.yml up -d
ExecStop=/usr/bin/podman compose -f compose.yml down

[Install]
WantedBy=multi-user.target