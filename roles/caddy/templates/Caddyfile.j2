# {{ ansible_managed }}
# Caddyfile for {{ inventory_hostname }}
# Generated from caddy_sites list in host_vars.
# Caddy handles TLS automatically via Let's Encrypt.

{
    email {{ caddy_email }}
}

{% for site in caddy_sites %}
{{ site.domain }} {
{% if site.type == 'static' %}
    root * {{ site.root }}
    file_server
    encode gzip zstd
{% elif site.type == 'proxy' %}
    reverse_proxy {{ hostvars[site.backend_host]['wg_ip'] }}:{{ site.backend_port }}
    encode gzip zstd
{% elif site.type == 'redirect' %}
    redir {{ site.target }} permanent
{% endif %}
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
    }
}

{% endfor %}