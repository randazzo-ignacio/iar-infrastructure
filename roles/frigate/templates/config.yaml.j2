# {{ ansible_managed }}
# Frigate NVR — config.yaml
# Generated by Ansible role: frigate
# Do not edit manually; changes will be overwritten.

mqtt:
  enabled: {{ frigate_mqtt_enabled | bool }}

tls:
  enabled: {{ frigate_tls_enabled | bool }}

ffmpeg:
  hwaccel_args: preset-nvidia

# Detection on GPU (Nacho's resource model, 2026-08-31: his LLMs
# need ~80GB RAM so agents run 90% CPU / 10% GPU -- the 3080 is
# free for detection. CPU detectors slow frigate AND the agents.)
#
# 2026-09-01: TensorRT detector type is REMOVED on amd64 in frigate
# 0.17 (ImportError at startup). The GPU path is the ONNX detector
# with CUDA EP. Frigate auto-enables CUDA graph capture for the
# default ssd model_type, which fails on the mmdeploy ssdlite
# (CPU-only nodes). The fix: YOLOv9-s 640x640 ONNX exported for
# frigate (negoti8za/frigate-yolo), fully CUDA-partitionable.
# Verified live on sophon: 10ms inference, detector on GPU.
detectors:
  onnx:
    type: onnx
    device: cuda
model:
  width: {{ frigate_model_width | default(640) }}
  height: {{ frigate_model_height | default(640) }}
  input_tensor: nchw
  input_pixel_format: rgb
  input_dtype: float
  path: {{ frigate_model_path | default('/config/model_cache/yolov9_s_640_frigate_cuda.onnx') }}
  labelmap_path: /labelmap/coco-80.txt

record:
  enabled: true
  continuous:
    days: {{ frigate_record_continuous_days }}
  motion:
    days: {{ frigate_record_motion_days }}
  alerts:
    retain:
      days: {{ frigate_record_alerts_days }}
      mode: {{ frigate_record_alerts_mode }}
  detections:
    retain:
      days: {{ frigate_record_detections_days }}
      mode: {{ frigate_record_detections_mode }}

{% if frigate_cameras | length > 0 %}
cameras:
{% for cam_name, cam in frigate_cameras.items() %}
  {{ cam_name }}:
    enabled: true
    friendly_name: {{ cam.friendly_name | default(cam_name) }}
    ffmpeg:
      inputs:
        - path: rtsp://127.0.0.1:{{ frigate_rtsp_port }}/{{ cam_name }}
          input_args: preset-rtsp-restream
          roles:
{% for role in cam.roles | default(['detect', 'record']) %}
            - {{ role }}
{% endfor %}
    detect:
      width: {{ cam.width | default(frigate_detect_width) }}
      height: {{ cam.height | default(frigate_detect_height) }}
    live:
      streams:
        Stream 1: {{ cam_name }}
{% endfor %}
{% endif %}

go2rtc:
  streams:
{% for cam_name, cam in frigate_cameras.items() %}
    {{ cam_name }}:
      - rtsp://{{ frigate_camera_rtsp_user }}:{{ frigate_camera_rtsp_password }}@{{ cam.rtsp_host }}{{ cam.rtsp_path }}
{% endfor %}

version: 0.17-0