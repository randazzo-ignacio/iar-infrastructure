[Unit]
Description=Restic backup service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=RESTIC_PASSWORD_FILE={{ restic_password_file }}
ExecStart=/bin/sh -c '{{ restic_binary }} --repo {{ restic_primary_repo }} backup {{ restic_backup_paths | join(" ") }} {{ restic_backup_excludes | map("regex_replace", "^(.*)$", "--exclude \\1") | join(" ") }} && {{ restic_binary }} --repo {{ restic_remote_repo }} backup {{ restic_backup_paths | join(" ") }} {{ restic_backup_excludes | map("regex_replace", "^(.*)$", "--exclude \\1") | join(" ") }}'
ExecStartPost=/bin/sh -c '{{ restic_binary }} --repo {{ restic_primary_repo }} forget --keep-daily {{ restic_keep_daily }} --keep-weekly {{ restic_keep_weekly }} --keep-monthly {{ restic_keep_monthly }} --keep-yearly {{ restic_keep_yearly }} --prune 2>/dev/null || true'
ExecStartPost=/bin/sh -c '{{ restic_binary }} --repo {{ restic_remote_repo }} forget --keep-daily {{ restic_keep_daily }} --keep-weekly {{ restic_keep_weekly }} --keep-monthly {{ restic_keep_monthly }} --keep-yearly {{ restic_keep_yearly }} --prune 2>/dev/null || true'

[Install]
WantedBy=multi-user.target