[Unit]
Description=Restic repository integrity check
After=network-online.target
Wants=network-online.target
{% if restic_local_repo is defined and restic_local_repo | length > 0 %}
After=mnt-backups.mount
Wants=mnt-backups.mount
{% endif %}
{% if restic_primary_mount is defined %}
# Fail closed: no check (and no accidental repo creation) on an
# unmounted primary filesystem.
Requires={{ restic_primary_mount }}
After={{ restic_primary_mount }}
{% endif %}

[Service]
Type=oneshot
Environment=RESTIC_PASSWORD_FILE={{ restic_password_file }}

ExecStart=/bin/sh -c '\
{% if restic_local_repo is defined and restic_local_repo | length > 0 %}
{{ restic_binary }} --retry-lock {{ restic_retry_lock | default('10m') }} --repo {{ restic_local_repo }} check 2>/dev/null || true && \
{% endif %}
{{ restic_binary }} --retry-lock {{ restic_retry_lock | default('10m') }} --repo {{ restic_primary_repo }} check 2>/dev/null || true && \
{{ restic_binary }} --retry-lock {{ restic_retry_lock | default('10m') }} --repo {{ restic_remote_repo }} check 2>/dev/null || true'
